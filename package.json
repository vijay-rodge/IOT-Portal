{
  "name": "iot-knowledge-portal",
  "version": "1.0.0",
  "description": "Comprehensive Educational and Reference Platform for IoT Devices",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": {
    "@vercel/node": "^16.0.2",
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "iot",
    "microcontrollers",
    "sensors",
    "actuators",
    "electronics",
    "education"
  ],
  "author": "IoT Knowledge Portal Team",
  "license": "MIT"
}
